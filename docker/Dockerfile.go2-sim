# Unitree GO2 Simulation Image
# This is a stub for future Gazebo/Isaac Sim integration

FROM agiros:loong-ros-base AS base

# Install Unitree GO2 dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    agiros-loong-slam-toolbox \
    agiros-loong-nav2-bringup \
    && rm -rf /var/lib/apt/lists/*

# Copy the Unitree GO2 package
COPY agiros_ws/src/unitree_go2 /agiros_ws/src/unitree_go2
COPY agiros_ws/src/agirosclaw_msgs /agiros_ws/src/agirosclaw_msgs

# Build AGIROS packages
WORKDIR /agiros_ws
RUN . /opt/agiros/loong/setup.sh && \
    colcon build --symlink-install

# Entrypoint
CMD ["agiros", "launch", "unitree_go2", "go2_launch.py"]
