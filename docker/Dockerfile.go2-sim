# Unitree GO2 Simulation Image
# This is a stub for future Gazebo/Isaac Sim integration

FROM ros:humble-ros-base AS base

# Install Unitree GO2 dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    ros-humble-slam-toolbox \
    ros-humble-nav2-bringup \
    && rm -rf /var/lib/apt/lists/*

# Copy the Unitree GO2 package
COPY ros2_ws/src/unitree_go2 /ros2_ws/src/unitree_go2
COPY ros2_ws/src/rosclaw_msgs /ros2_ws/src/rosclaw_msgs

# Build ROS2 packages
WORKDIR /ros2_ws
RUN . /opt/ros/humble/setup.sh && \
    colcon build --symlink-install

# Entrypoint
CMD ["ros2", "launch", "unitree_go2", "go2_launch.py"]
