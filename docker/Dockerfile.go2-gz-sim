# AGIROS loong + Gazebo Harmonic Sim for Unitree GO2
# 基于 ROS2-Gazebo-GO2 项目 Dockerfile 优化
FROM osrf/ros:loong-desktop-full

LABEL maintainer="RosClaw Team"
LABEL description="Unitree GO2 Gazebo Simulation"

# 设置非交互模式
ENV DEBIAN_FRONTEND=noninteractive

# 安装 go2_gz_sim 依赖和 RosClaw 所需包
RUN apt-get update && apt-get install -y --no-install-recommends \
    # 基础构建工具
    build-essential \
    git \
    wget \
    # Gazebo 相关
    agiros-loong-gazebo-ros \
    agiros-loong-gazebo-plugins \
    agiros-loong-gazebo-dev \
    agiros-loong-ros-gz \
    agiros-loong-gz-ros2-control \
    # 机器人描述和状态发布
    agiros-loong-xacro \
    agiros-loong-urdf \
    agiros-loong-robot-state-publisher \
    agiros-loong-joint-state-publisher \
    agiros-loong-joint-state-broadcaster \
    # 控制器
    agiros-loong-controller-manager \
    agiros-loong-ros2-control \
    agiros-loong-ros2-controllers \
    # 导航和 SLAM
    agiros-loong-slam-toolbox \
    agiros-loong-nav2-bringup \
    agiros-loong-navigation2 \
    agiros-loong-robot-localization \
    # 通信和桥接
    agiros-loong-rosbridge-suite \
    agiros-loong-rmw-cyclonedds-cpp \
    agiros-loong-cyclonedds \
    # 坐标变换
    agiros-loong-tf-transformations \
    agiros-loong-tf2-ros \
    agiros-loong-tf2-geometry-msgs \
    agiros-loong-rqt-tf-tree \
    # 工具和 UI
    agiros-loong-rqt \
    agiros-loong-rqt-common-plugins \
    agiros-loong-rqt-robot-steering \
    agiros-loong-teleop-twist-keyboard \
    # 传感器
    agiros-loong-velodyne-description \
    && apt clean && \
    rm -rf /var/lib/apt/lists/*

# 恢复前端环境变量
ENV DEBIAN_FRONTEND=

# 创建非 root 用户（安全性）
ARG USER_ID=1000
ARG GROUP_ID=1000

RUN groupadd -g ${GROUP_ID} rosuser && \
    useradd -u ${USER_ID} -g rosuser -m -s /bin/bash rosuser && \
    echo "rosuser ALL=(ALL) NOPASSWD:ALL" >> /etc/sudoers

# 设置工作目录
WORKDIR /opt/go2_gz_sim

# 复制并构建 RosClaw AGIROS 包
COPY agiros_ws/src /opt/rosclaw/src
RUN bash -c "source /opt/agiros/loong/setup.sh && \
    colcon build --packages-skip unitree_go2 --install-base /opt/rosclaw/install && \
    rm -rf build log"

# 设置 AGIROS 环境
RUN echo "source /opt/agiros/loong/setup.bash" >> /home/rosuser/.bashrc && \
    echo "export GZ_SIM_RESOURCE_PATH=/opt/go2_gz_sim/models:/opt/go2_gz_sim/src/gazebo_sim/world" >> /home/rosuser/.bashrc

# 入口点脚本
COPY docker/scripts/go2-gz-entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh

# 切换为非 root 用户
USER rosuser

ENTRYPOINT ["/entrypoint.sh"]
CMD ["agiros", "launch", "gazebo_sim", "launch.py"]
