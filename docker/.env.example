# RosClaw Docker Configuration
# Copy this file to .env and customize as needed:
#   cp .env.example .env

# ============================================
# Network Configuration
# ============================================

# Docker network name (use existing network like 1panel-network, or create new)
DOCKER_NETWORK_NAME=1panel-network
DOCKER_NETWORK_EXTERNAL=true

# ============================================
# ROS2 Configuration
# ============================================

# ROS2 domain ID
ROS_DOMAIN_ID=0

# TurtleBot3 model: burger, waffle, waffle_pi
TURTLEBOT3_MODEL=burger

# rosbridge WebSocket port
ROSBRIDGE_PORT=9090

# ROS master port (usually not needed for rosbridge-only setups)
ROS_MASTER_PORT=11311

# ============================================
# OpenClaw Gateway Configuration
# ============================================

# OpenClaw Gateway port
OPENCLAW_PORT=18789

# OpenClaw log level: debug, info, warn, error
OPENCLAW_LOG_LEVEL=info

# OpenClaw state directory (inside container)
OPENCLAW_STATE_DIR=/home/node/.openclaw

# Gateway token (auto-generated if empty)
OPENCLAW_GATEWAY_TOKEN=

# ============================================
# RosClaw Plugin Configuration
# ============================================

# Transport mode: rosbridge, local, webrtc
ROSCLAW_TRANSPORT_MODE=rosbridge

# rosbridge WebSocket URL (use docker service name when in same network)
# For local development: ws://localhost:9090
# For Docker network: ws://ros2:9090
# Note: Update this if you change ROSBRIDGE_PORT
ROSCLAW_ROSBRIDGE_URL=ws://ros2:9090

# Robot name
ROSCLAW_ROBOT_NAME="TurtleBot3 (Sim)"

# Reconnect settings
ROSCLAW_RECONNECT=true
ROSCLAW_RECONNECT_INTERVAL=3000

# ============================================
# GPU Configuration (for Gazebo simulation)
# ============================================

# Enable GPU acceleration for Gazebo
# Set to true to enable GPU acceleration in Docker container
# Requires NVIDIA Container Toolkit installed
ROSCLAW_ENABLE_GPU=false

# NVIDIA visible devices (all, none, or comma-separated GPU IDs)
NVIDIA_VISIBLE_DEVICES=all

# NVIDIA driver capabilities (graphics, utility, compute, video, display)
NVIDIA_DRIVER_CAPABILITIES=graphics,utility,compute
